{
  "plugins": ["opencode-context-pruner"],
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  // === Models ===
  "model": "opencode-go/muse-spark-1.3-contributor",
  "small_model": "openai/gpt-6-luna",
  // === Permissions ===
  "permission": {
    "external_directory": "allow",
    "bash": {
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      ":(){:|:&};:": "deny",
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}",
      },
      "enabled": true,
    },
    "grep.app": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true,
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp?exaApiKey={env:EXA_API_KEY}",
      "enabled": true,
    },
    "servers": {
      "workos": {
        "type": "remote",
        "url": "https://mcp.workos.com/mcp"
      },
      "stripe": {
        "type": "remote",
        "url": "https://mcp.stripe.com"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      }
    },
    "posthog": {
      "type": "remote",
      "url": "https://mcp.posthog.com/mcp"
    },
  },
  // === Providers ===
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "none",
          },
        },
        "gpt-5.6-luna-fast": {
          "options": {
            "reasoningEffort": "max",
          },
        },
      },
    },
  },
  "providers": {
    "lmstudio": {
      "settings": {
        "baseURL": "http://127.0.0.1:1234/v1"
      }
    }
  },
  // === Server ===
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0",
  },
}
