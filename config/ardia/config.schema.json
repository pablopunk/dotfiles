{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Ardia's config.json. Ardia applies it at launch and whenever it changes; it never writes it.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "theme": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "A theme in themes/<name>.json, or null for Ardia's own",
      "default": null
    },
    "settings": {
      "type": "object",
      "properties": {
        "warnBeforeQuitting": {
          "type": "boolean",
          "default": false
        },
        "warnBeforeClosingWindow": {
          "type": "boolean",
          "default": true
        },
        "restoreSession": {
          "type": "boolean",
          "default": true
        },
        "searchEngine": {
          "type": "string",
          "default": "google",
          "description": "An engine id: google, bing, duckduckgo, perplexity, chatgpt, ecosia, brave, kagi, startpage, yahoo, baidu, yandex, or one added in Settings"
        },
        "searchSuggestions": {
          "type": "boolean",
          "default": true
        },
        "showSelectionSearch": {
          "type": "boolean",
          "default": true
        },
        "commandBarPreference": {
          "type": "string",
          "enum": [
            "website",
            "search"
          ],
          "default": "website"
        },
        "tabLayout": {
          "type": "string",
          "enum": [
            "sidebar",
            "top"
          ],
          "default": "sidebar"
        },
        "hideToolbarWhileScrolling": {
          "type": "boolean",
          "default": true
        },
        "newTabPosition": {
          "type": "string",
          "enum": [
            "top",
            "bottom",
            "nextToCurrent"
          ],
          "default": "bottom"
        },
        "newTabButtonPosition": {
          "type": "string",
          "enum": [
            "top",
            "bottom"
          ],
          "default": "bottom"
        },
        "newTabOpens": {
          "type": "string",
          "enum": [
            "page",
            "commandBar"
          ],
          "default": "page"
        },
        "warnBeforeClosingLastTab": {
          "type": "boolean",
          "default": true
        },
        "undoReopensClosedTab": {
          "type": "boolean",
          "default": false
        },
        "warnBeforeMovingTabsToProfile": {
          "type": "boolean",
          "default": true
        },
        "shareTabsAcrossWindows": {
          "type": "boolean",
          "default": false
        },
        "tabReorderHaptics": {
          "type": "boolean",
          "default": true
        },
        "extendWebsiteColor": {
          "type": "boolean",
          "default": true
        },
        "cmdClickCreatesTabGroup": {
          "type": "boolean",
          "default": true
        },
        "optShiftClickOpensInGroup": {
          "type": "boolean",
          "default": true
        },
        "peekModifier": {
          "type": "string",
          "enum": [
            "alt",
            "shift",
            "off"
          ],
          "default": "shift"
        },
        "peekLinksToOtherSites": {
          "type": "boolean",
          "default": false
        },
        "splitLinkModifier": {
          "type": "string",
          "enum": [
            "altShift",
            "alt"
          ],
          "default": "altShift"
        },
        "autoGroupMeetingTabs": {
          "type": "boolean",
          "default": true
        },
        "cleanUpInactiveTabsAfterMinutes": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0,
          "default": null
        },
        "mutedSites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "neverTranslateSites": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {}
        },
        "autoPictureInPicture": {
          "type": "boolean",
          "default": true
        },
        "commandScrollZoom": {
          "type": "boolean",
          "default": true
        },
        "videoUpscaling": {
          "type": "boolean",
          "default": true
        },
        "sidebarMediaControls": {
          "type": "boolean",
          "default": true
        },
        "sidebarWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 190
        },
        "showSidebarButton": {
          "type": "boolean",
          "default": true
        },
        "showClearButton": {
          "type": "boolean",
          "default": true
        },
        "balancedTopApps": {
          "type": "boolean",
          "default": false
        },
        "showAdvancedSettings": {
          "type": "boolean",
          "default": false
        },
        "selectedTabGlow": {
          "type": "string",
          "enum": [
            "full",
            "soft",
            "off"
          ],
          "default": "full"
        },
        "interfaceStyle": {
          "type": "string",
          "enum": [
            "glass",
            "classic"
          ],
          "default": "glass"
        },
        "glassTintWithTheme": {
          "type": "boolean",
          "default": false
        },
        "glassTintAmount": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.8
        },
        "pageScrollBars": {
          "type": "string",
          "enum": [
            "system",
            "thin"
          ],
          "default": "system"
        },
        "fadeUnloadedTabs": {
          "type": "boolean",
          "default": false
        },
        "warnBeforeClosingTabGroup": {
          "type": "boolean",
          "default": true
        },
        "batterySaverWhen": {
          "type": "string",
          "enum": [
            "lowBattery",
            "unplugged",
            "never"
          ],
          "default": "lowBattery"
        },
        "memorySaver": {
          "type": "boolean",
          "default": true
        },
        "memorySaverMode": {
          "type": "string",
          "enum": [
            "moderate",
            "balanced",
            "maximum"
          ],
          "default": "balanced"
        },
        "keepActiveSites": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "extensionSidePanelWidth": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 360
        },
        "showFullUrl": {
          "type": "boolean",
          "default": false
        },
        "bookmarksBar": {
          "type": "string",
          "enum": [
            "always",
            "newTab",
            "never"
          ],
          "default": "never"
        },
        "bookmarksBarSize": {
          "type": "string",
          "enum": [
            "default",
            "large"
          ],
          "default": "default"
        },
        "hideBookmarksBarImport": {
          "type": "boolean",
          "default": false
        },
        "appearance": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "default": "auto"
        },
        "addressBar": {
          "type": "string",
          "enum": [
            "toolbar",
            "sidebar"
          ],
          "default": "toolbar"
        },
        "compactToolbar": {
          "type": "boolean",
          "default": false
        },
        "commandBarPlacement": {
          "type": "string",
          "enum": [
            "field",
            "centred"
          ],
          "default": "field"
        },
        "spacesFollowAppearance": {
          "type": "boolean",
          "default": true
        },
        "profileSwitcherIcons": {
          "type": "boolean",
          "default": false
        },
        "shortcuts": {
          "type": "object",
          "description": "Command id to shortcut. One shortcut: modifiers cmd, opt (option, alt), ctrl (control), shift or fn joined by +, then one key (a character, f1–f20, space, tab, return, escape, delete, up, down, left, right, home, end, pageup, pagedown), as in \"cmd+shift+t\"; or in glyphs, as in \"⇧⌘T\". \"\" unbinds the command. A command left out keeps what it has.",
          "properties": {
            "newTab": {
              "type": "string",
              "description": "New Tab (default ⌘T)"
            },
            "newWindow": {
              "type": "string",
              "description": "New Window (default ⌘N)"
            },
            "newIncognitoWindow": {
              "type": "string",
              "description": "New Incognito Window (default ⇧⌘N)"
            },
            "newLittleArdia": {
              "type": "string",
              "description": "New Little Ardia Window (default ⌥⌘N)"
            },
            "toggleOpenLinksInLittleArdia": {
              "type": "string",
              "description": "Open Links from Other Apps in Main Window (no default)"
            },
            "reopenClosedTab": {
              "type": "string",
              "description": "Reopen Closed Tab (default ⇧⌘T)"
            },
            "reopenClosedWindow": {
              "type": "string",
              "description": "Reopen Closed Window (no default)"
            },
            "restoreClosed": {
              "type": "string",
              "description": "restoreClosed (no default)"
            },
            "focusCommandBar": {
              "type": "string",
              "description": "Open Command Bar (default ⌘L, ⌃F5)"
            },
            "closeTab": {
              "type": "string",
              "description": "Close Tab (default ⌘W)"
            },
            "closeAllTabs": {
              "type": "string",
              "description": "Close All Tabs (default ⇧⌘K)"
            },
            "print": {
              "type": "string",
              "description": "Print… (default ⌘P)"
            },
            "copyUrl": {
              "type": "string",
              "description": "Copy URL (default ⇧⌘C)"
            },
            "copyUrlAsMarkdown": {
              "type": "string",
              "description": "Copy URL as Markdown (default ⌥⇧⌘C)"
            },
            "findInPage": {
              "type": "string",
              "description": "Find… (default ⌘F)"
            },
            "findNext": {
              "type": "string",
              "description": "Find Next (default ⌘G)"
            },
            "findPrevious": {
              "type": "string",
              "description": "Find Previous (default ⇧⌘G)"
            },
            "setAppearance": {
              "type": "string",
              "description": "setAppearance (no default)"
            },
            "setAppearance:auto": {
              "type": "string",
              "description": "Automatic (no default)"
            },
            "setAppearance:light": {
              "type": "string",
              "description": "Light (no default)"
            },
            "setAppearance:dark": {
              "type": "string",
              "description": "Dark (no default)"
            },
            "reload": {
              "type": "string",
              "description": "Refresh (default ⌘R)"
            },
            "forceReload": {
              "type": "string",
              "description": "Force Refresh the Page (default ⇧⌘R)"
            },
            "toggleTabLayout": {
              "type": "string",
              "description": "Show Tabs in Sidebar (default ⇧⌘S)"
            },
            "toggleSidebar": {
              "type": "string",
              "description": "Auto-Hide Tabs (default ⌘S, ⇧⌘L, ⇧⌘F)"
            },
            "openSplitPane": {
              "type": "string",
              "description": "Open Split Pane (default ⌃⇧=, ⌃+)"
            },
            "useSelectionForFind": {
              "type": "string",
              "description": "Use Selection for Find (default ⌘E)"
            },
            "findAndReplace": {
              "type": "string",
              "description": "Find and Replace… (default ⌥⌘F)"
            },
            "jumpToSelection": {
              "type": "string",
              "description": "Jump to Selection (default ⌘J)"
            },
            "focusNextPane": {
              "type": "string",
              "description": "Focus Next Split Pane (default ⌃⇧], ⌃})"
            },
            "focusPreviousPane": {
              "type": "string",
              "description": "Focus Previous Split Pane (default ⌃⇧[, ⌃{)"
            },
            "toggleFullUrl": {
              "type": "string",
              "description": "Show Full URL (no default)"
            },
            "toggleJavaScriptFromAppleEvents": {
              "type": "string",
              "description": "Allow JavaScript from Apple Events (no default)"
            },
            "toggleAddressBar": {
              "type": "string",
              "description": "Show Address Bar in Sidebar (no default)"
            },
            "cast": {
              "type": "string",
              "description": "Cast… (no default)"
            },
            "zoomReset": {
              "type": "string",
              "description": "Zoom to Actual Size (default ⌘0)"
            },
            "zoomIn": {
              "type": "string",
              "description": "Zoom In (default ⌘+, ⌘=)"
            },
            "zoomOut": {
              "type": "string",
              "description": "Zoom Out (default ⌘-)"
            },
            "devTools": {
              "type": "string",
              "description": "Developer Tools (default ⌥⌘I)"
            },
            "toggleDevTools": {
              "type": "string",
              "description": "Toggle Developer Tools (default F12)"
            },
            "javaScriptConsole": {
              "type": "string",
              "description": "JavaScript Console (default ⌥⌘J)"
            },
            "inspectElements": {
              "type": "string",
              "description": "Inspect Elements (default ⌥⌘C)"
            },
            "viewSource": {
              "type": "string",
              "description": "View Source (default ⌥⌘U)"
            },
            "back": {
              "type": "string",
              "description": "Go Back (default ⌘[, ⌘←)"
            },
            "forward": {
              "type": "string",
              "description": "Go Forward (default ⌘], ⌘→)"
            },
            "nextTab": {
              "type": "string",
              "description": "Next Tab (default ⇧⌘], ⌘}, ⌥⌘→, ⌃⇟, ⌥⌘↓)"
            },
            "previousTab": {
              "type": "string",
              "description": "Previous Tab (default ⇧⌘[, ⌘{, ⌥⌘←, ⌃⇞, ⌥⌘↑)"
            },
            "selectTab": {
              "type": "string",
              "description": "selectTab (no default)"
            },
            "selectTab:1": {
              "type": "string",
              "description": "Select Tab 1 (default ⌘1)"
            },
            "selectTab:2": {
              "type": "string",
              "description": "Select Tab 2 (default ⌘2)"
            },
